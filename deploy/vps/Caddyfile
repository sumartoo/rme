# HTTPS otomatis (Let's Encrypt) per subdomain tanpa API DNS: "on-demand TLS".
# Sebelum menerbitkan sertifikat, Caddy bertanya ke API (jaringan internal) apakah subdomain itu konsol atau klinik
# yang dilayani — subdomain sembarang ditolak (mencegah penyalahgunaan & batas kuota Let's Encrypt).
{
	email {$ACME_EMAIL}
	on_demand_tls {
		ask http://api:3000/internal/tls-allowed
	}
}

(common) {
	tls {
		on_demand
	}
	encode zstd gzip
	# Header keamanan diatur aplikasi (CSP bernonce, no-store); Caddy hanya menambah HSTS & menyembunyikan server
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# Endpoint internal tidak pernah lewat sini
	@internal path /internal/*
	respond @internal 404
}

admin.{$BASE_DOMAIN} {
	import common
	reverse_proxy platform-admin:3000
}

*.{$BASE_DOMAIN} {
	import common
	reverse_proxy web:3000
}
