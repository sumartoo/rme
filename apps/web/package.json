{
  "name": "@clinicrme/web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "sourceRoot": "apps/web/src",
    "tags": [
      "type:app",
      "scope:web"
    ],
    "targets": {
      "dev": {
        "executor": "nx:run-commands",
        "continuous": true,
        "options": {
          "command": "next dev --port 4200",
          "cwd": "apps/web"
        }
      }
    }
  },
  "dependencies": {
    "next": "~16.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@clinicrme/ui": "workspace:*",
    "@hookform/resolvers": "^7.0.2",
    "qrcode": "^1.5.4",
    "react-hook-form": "^7.91.0",
    "zod": "^4.6.7",
    "lucide-react": "^1.67.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "tailwindcss": "^4.3.4",
    "postcss": "^8.5.32",
    "@types/qrcode": "^1.5.6"
  }
}
