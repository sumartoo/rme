{
  "name": "@clinicrme/api",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/api/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/api/dist/patches",
          "{workspaceRoot}/apps/api/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "readyWhen": {
          "signal": true
        },
        "options": {
          "buildTarget": "@clinicrme/api:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "@clinicrme/api:build:development"
          },
          "production": {
            "buildTarget": "@clinicrme/api:build:production"
          }
        }
      },
      "test": {
        "options": {
          "passWithNoTests": true
        }
      },
      "test-integration": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "jest --config jest.integration.config.cts --runInBand",
          "cwd": "apps/api"
        }
      }
    },
    "tags": [
      "type:app",
      "scope:api"
    ]
  },
  "dependencies": {
    "@clinicrme/db": "workspace:*",
    "@clinicrme/iam": "workspace:*",
    "@clinicrme/masterdata": "workspace:*",
    "@clinicrme/patient": "workspace:*",
    "@clinicrme/platform": "workspace:*",
    "@clinicrme/shared": "workspace:*",
    "@clinicrme/storage": "workspace:*",
    "@clinicrme/tenant": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^5",
    "nestjs-pino": "^4.6.1",
    "otplib": "^12",
    "pg": "^8.16",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.0.0",
    "supertest": "^7.3.1",
    "yaml": "^2.9.0"
  }
}
