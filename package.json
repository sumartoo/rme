{
  "name": "@clinicrme/source",
  "version": "0.0.0",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "pnpm dev:setup && nx run-many -t serve dev -p @clinicrme/api @clinicrme/worker @clinicrme/web @clinicrme/platform-admin --parallel=4",
    "dev:setup": "pnpm dev:env && pnpm dev:infra && pnpm dev:db && pnpm dev:seed",
    "dev:env": "node tools/dev/env.mjs",
    "dev:infra": "docker compose up -d --wait",
    "dev:down": "docker compose down",
    "dev:db": "tsx tools/dev/db.ts",
    "dev:seed": "tsx tools/dev/seed.ts",
    "dev:reset-mfa": "tsx tools/dev/reset-platform-mfa.ts",
    "db:migrate": "tsx libs/db/src/bin/migrate.ts",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "test:integration": "nx run @clinicrme/api:test-integration",
    "test:db": "bash db/tests/run_tests.sh",
    "test:mutation": "bash tools/run_mutation_tests.sh",
    "check:schema": "bash tools/check_schema_parity.sh",
    "build": "nx run-many -t build",
    "smoke:worker": "node apps/worker/dist/main.js",
    "test:e2e": "nx run @clinicrme/platform-admin:e2e"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@next/eslint-plugin-next": "^16.1.6",
    "@nx/eslint": "24.0.4",
    "@nx/eslint-plugin": "24.0.4",
    "@nx/jest": "24.0.4",
    "@nx/js": "24.0.4",
    "@nx/nest": "24.0.4",
    "@nx/next": "24.0.4",
    "@nx/node": "24.0.4",
    "@nx/web": "24.0.4",
    "@nx/webpack": "24.0.4",
    "@swc-node/register": "1.11.1",
    "@swc/cli": "~0.8.1",
    "@swc/core": "1.15.8",
    "@swc/helpers": "0.5.18",
    "@swc/jest": "~0.2.38",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "~30.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.1",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "5.0.0",
    "jest": "~30.3.0",
    "jest-environment-jsdom": "~30.3.0",
    "jest-environment-node": "~30.3.0",
    "jest-util": "~30.3.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "24.0.4",
    "prettier": "^3.8.1",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.7",
    "ts-node": "10.9.1",
    "tslib": "^2.3.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.58.0",
    "webpack": "~5.110.0",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1",
    "@playwright/test": "^1.64.1"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12 <23",
    "pnpm": ">=10.28"
  }
}
