{
  "name": "@clinicrme/db",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./tenant-export": {
      "types": "./src/lib/tenant-export.ts",
      "import": "./src/lib/tenant-export.ts",
      "default": "./src/lib/tenant-export.ts"
    },
    "./notifications": {
      "types": "./src/lib/notifications.ts",
      "import": "./src/lib/notifications.ts",
      "default": "./src/lib/notifications.ts"
    },
    "./no-show": {
      "types": "./src/lib/no-show.ts",
      "import": "./src/lib/no-show.ts",
      "default": "./src/lib/no-show.ts"
    },
    "./reference": {
      "types": "./src/lib/reference.ts",
      "import": "./src/lib/reference.ts",
      "default": "./src/lib/reference.ts"
    }
  },
  "nx": {
    "tags": [
      "type:data"
    ]
  },
  "dependencies": {
    "@clinicrme/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "tslib": "^2.3.0",
    "@clinicrme/storage": "workspace:*"
