# Salin otomatis ke .env oleh `pnpm dev:env` (nilai acak dibuat untuk kunci & password). Jangan commit .env.
# Jangan set NODE_ENV di sini: Nx memuat .env ke semua task, dan `next build` wajib NODE_ENV=production.
APP_ENV=local
LOG_LEVEL=info

# --- PostgreSQL (docker compose) ---
POSTGRES_PORT=5432
POSTGRES_DB=clinicrme
POSTGRES_OWNER_USER=clinicrme_owner
POSTGRES_OWNER_PASSWORD=__RANDOM__
# Role LOGIN aplikasi: anggota clinicrme_app, NOBYPASSRLS, bukan owner (dibuat oleh pnpm dev:db)
POSTGRES_API_USER=clinicrme_api
POSTGRES_API_PASSWORD=__RANDOM__
# Role LOGIN konsol platform: anggota clinicrme_platform — tanpa akses tabel klinis (CR-0001; dibuat oleh pnpm dev:db)
POSTGRES_PLATFORM_USER=clinicrme_platform_api
POSTGRES_PLATFORM_PASSWORD=__RANDOM__

MIGRATION_DATABASE_URL=postgres://${POSTGRES_OWNER_USER}:${POSTGRES_OWNER_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL=postgres://${POSTGRES_API_USER}:${POSTGRES_API_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
PLATFORM_DATABASE_URL=postgres://${POSTGRES_PLATFORM_USER}:${POSTGRES_PLATFORM_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}
# Worker sementara memakai owner: pg-boss membuat skema pgboss sendiri (role khusus di Stage 15)
WORKER_DATABASE_URL=${MIGRATION_DATABASE_URL}

# --- API --- (port default 3000; web dev di 4200)
# Tenant dari subdomain: http://demo.localhost:3000 (browser modern me-resolve *.localhost ke 127.0.0.1)
# Konsol platform: http://admin.localhost:3000 (subdomain "admin" tercadang, tidak bisa jadi kode klinik)
BASE_DOMAIN=localhost
COOKIE_SECURE=false
ENCRYPTION_KEY_HEX=__RANDOM_HEX32__

# --- Penyimpanan berkas (ADR-0013) ---
# Lokal: folder .data/storage (driver fs). Untuk mencoba emulator GCS dari docker compose:
# STORAGE_DRIVER=gcs dan STORAGE_GCS_ENDPOINT=http://localhost:4443 (bucket dibuat otomatis oleh pnpm dev:db).
STORAGE_DRIVER=fs
STORAGE_FS_DIR=.data/storage
# Masa berlaku tautan unduh ekspor data tenant (jam)
EXPORT_TTL_HOURS=24

# --- Email (worker, outbox → SMTP) ---
# Lokal: Mailpit dari docker compose (kotak masuk di http://localhost:8025). Kosongkan SMTP_URL untuk mematikan
# pengiriman (event tetap PENDING di outbox). Penyedia SMTP cloud diputuskan sebelum pilot.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="ClinicRME <no-reply@clinicrme.local>"
# Tautan aplikasi klinik di email undangan; {code} = kode tenant
CLINIC_URL_TEMPLATE=http://{code}.localhost:4200

# Google Sign-In: isi dari OAuth client khusus dev (Google Cloud Console). Tanpa ini login Google tidak aktif,
# login email+password tetap berfungsi.
GOOGLE_ISSUER=https://accounts.google.com
GOOGLE_CLIENT_ID=belum-diisi
GOOGLE_CLIENT_SECRET=belum-diisi
GOOGLE_REDIRECT_URI=http://demo.localhost:4200/api/v1/auth/google/callback

# Password akun demo (sintetis) untuk `pnpm dev:seed` — dibuat acak oleh dev:env.
# Dipakai juga untuk admin konsol platform admin@platform.test (TOTP didaftarkan saat login pertama).
DEV_SEED_PASSWORD=__RANDOM__
